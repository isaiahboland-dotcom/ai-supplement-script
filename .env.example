### AI Settings
# who's your fav: lmstudio | ollama | openai | claude
LLM_PROVIDER=lmstudio

# since I forget
#   lmstudio -> http://localhost:1234/v1
#   ollama   -> http://localhost:11434
#   openai   -> https://api.openai.com/v1   (works with any OpenAI-compatible server too)
#   claude   -> Anthropic's API
LLM_BASE_URL=

# which model you want
LLM_MODEL=

# only needed for openai and claude. OPENAI_API_KEY / ANTHROPIC_API_KEY work too.
LLM_API_KEY=

# Optional knobs, ignore if you don't care or have them set server side:
# LLM_TEMPERATURE=0.2        # defaults to 0.2 for lmstudio/ollama; not sent to openai/claude unless you set it
# LLM_TIMEOUT=600            # seconds per call — local models can be slow, be patient
# LLM_MAX_TOKENS=16000       # max reply length (Claude only)
# OLLAMA_NUM_CTX=32768       # Ollama's context window; research eats a lot of context
# LLM_EFFORT=medium          # Claude only: low | medium | high | xhigh | max (defaults to high)
# CLAUDE_FALLBACKS=default   # set to "off" if you don't want the auto fallback model when Claude says no

### Web Search
# brave | searxng
SEARCH_PROVIDER=brave

BRAVE_API_KEY=

# SearXNG: point this at your instance. You'll need JSON output turned on in its settings.yml:
#   search:
#     formats: [html, json]
SEARXNG_URL=http://localhost:8080

# SEARCH_RESULTS=8
# FETCH_MAX_CHARS=8000

### Loop settings
# MAX_RESEARCH_STEPS=30      # 15-30 should be solid
# MIN_SEARCHES=4

### Output settings
# OUTPUT_DIR=output
# EXCEL_FILE=supplements_research.xlsx

### Grist - optional
# Fill in GRIST_URL and results go to Grist — if Grist hiccups, we fall back to the Excel file.
# Leave GRIST_URL empty and it writes to an excel on disk
GRIST_URL=
GRIST_DOC_ID=
GRIST_TABLE_ID=Table1
GRIST_API_KEY=
